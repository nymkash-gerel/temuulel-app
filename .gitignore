# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/blob-report/
/test-results/
/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code — ignore personal/cache, but commit shared config
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/HOOKS.md
.claude/hooks/*.local.*
# custom sub-agents (all project-authored)
!.claude/agents/
# only project-authored skills, not the 100+ marketplace ones
!.claude/skills/
.claude/skills/*
!.claude/skills/add-resource/
!.claude/skills/ship/
!.claude/skills/audit-vertical/

# typescript
*.tsbuildinfo
next-env.d.ts
/specs
/test-scenarios
.env*.local
models/
