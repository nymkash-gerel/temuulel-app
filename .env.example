# =============================================================================
# Temuulel Environment Variables
# =============================================================================
#
# Copy this file to .env.local and fill in the values.
#
# Legend:
#   REQUIRED  — App will not function without this
#   OPTIONAL  — Feature disabled if unset, app still works
#   PUBLIC    — Exposed to browser (NEXT_PUBLIC_* prefix). BUILD-TIME INLINED:
#               Next.js substitutes the literal value into the JS bundle during
#               `next build`. It MUST be set in Vercel BEFORE the build runs.
#               Adding or changing one afterwards needs a full REDEPLOY —
#               restarting/redeploying without rebuilding will NOT pick it up.
#   SERVER    — Server-only, never sent to client. Read from process.env at
#               request time, so a change takes effect on the next deploy
#               without needing the value present at build time.
#
# Boot validation:
#   src/lib/env.ts runs from instrumentation.ts register() on server start.
#   Anything marked REQUIRED below throws a loud, named error at boot when
#   NODE_ENV=production. Everything else only warns. `next build` warns but
#   never throws, so a local build without .env.local still works.
#
# Rotation schedule:
#   Quarterly — OPENAI_API_KEY, RESEND_API_KEY, QSTASH_*, QPAY_PASSWORD, UPSTASH_REDIS_REST_TOKEN, SUPABASE_SECRET_KEY, STRIPE_SECRET_KEY, LANGFUSE_SECRET_KEY
#   On team change — SUPABASE_SECRET_KEY, CRON_SECRET, SLACK_*_WEBHOOK_URL
#   Annually — VAPID keys
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (REQUIRED) - Using Modern API Keys
# Get keys from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co   # PUBLIC  | REQUIRED — build-time inlined
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...                  # PUBLIC  | REQUIRED — build-time inlined; publishable key (safe for client)
SUPABASE_SECRET_KEY=sb_secret_...                            # SERVER  | REQUIRED — Secret key (server-only, never expose)

# DEPRECATED - Don't use these anymore (migrated to API keys 2026-02-23):
# NEXT_PUBLIC_SUPABASE_ANON_KEY (replaced by NEXT_PUBLIC_SUPABASE_KEY)
# SUPABASE_SERVICE_ROLE_KEY (replaced by SUPABASE_SECRET_KEY)
# Still accepted as a fallback by src/lib/env.ts and the Supabase clients, but
# boot validation logs a deprecation warning. Remove them once migrated.

# -----------------------------------------------------------------------------
# App (REQUIRED)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app           # PUBLIC  | REQUIRED — build-time inlined

# -----------------------------------------------------------------------------
# Facebook / Instagram (OPTIONAL — social integrations)
# -----------------------------------------------------------------------------
FACEBOOK_APP_ID=                       # SERVER  | OPTIONAL
FACEBOOK_APP_SECRET=                   # SERVER  | OPTIONAL — rotate quarterly
FACEBOOK_PAGE_ACCESS_TOKEN=            # SERVER  | OPTIONAL
MESSENGER_VERIFY_TOKEN=                # SERVER  | OPTIONAL
INSTAGRAM_APP_ID=                      # SERVER  | OPTIONAL

# -----------------------------------------------------------------------------
# Telegram Bot (OPTIONAL — staff notifications via Telegram)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=                    # SERVER  | OPTIONAL — rotate on compromise
TELEGRAM_BOT_USERNAME=                 # SERVER  | OPTIONAL — read server-side by src/lib/telegram.ts + /api/team/telegram
TELEGRAM_WEBHOOK_SECRET=               # SERVER  | OPTIONAL — set via setWebhook?secret_token=, verified in /api/webhook/telegram

# Same bot username, second copy for client components (the deep-link button on
# /dashboard/settings/telegram). Set BOTH to the identical value — they are not
# interchangeable: the server one is read at request time, this one is baked in
# at build time.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=     # PUBLIC  | OPTIONAL — build-time inlined; must match TELEGRAM_BOT_USERNAME

# -----------------------------------------------------------------------------
# Driver Telegram Bot (OPTIONAL — delivery-driver bot, separate from the staff
# bot above. Powers /api/telegram/driver/* and /dashboard/delivery-drivers)
# -----------------------------------------------------------------------------
DRIVER_TELEGRAM_BOT_TOKEN=             # SERVER  | OPTIONAL — rotate on compromise
DRIVER_TELEGRAM_WEBHOOK_SECRET=        # SERVER  | OPTIONAL — set via setWebhook?secret_token=, verified in /api/telegram/driver
NEXT_PUBLIC_DRIVER_TELEGRAM_BOT_USERNAME=  # PUBLIC  | OPTIONAL — build-time inlined; driver-invite deep links

# -----------------------------------------------------------------------------
# Email Notifications — Resend (OPTIONAL — email features)
# -----------------------------------------------------------------------------
RESEND_API_KEY=                        # SERVER  | OPTIONAL — rotate quarterly

# Canonical sender address for every outgoing email (transactional + campaigns).
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com  # SERVER  | OPTIONAL

# DEPRECATED alias for NOTIFICATION_FROM_EMAIL. /api/email-campaign historically
# read this name only; it now prefers NOTIFICATION_FROM_EMAIL and falls back to
# this. Set NOTIFICATION_FROM_EMAIL instead — leaving only this set means
# campaign mail and transactional mail can ship from different addresses.
RESEND_FROM_EMAIL=                     # SERVER  | OPTIONAL — deprecated fallback

# -----------------------------------------------------------------------------
# Web Push Notifications — VAPID (OPTIONAL — browser push)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=          # PUBLIC  | OPTIONAL
VAPID_PRIVATE_KEY=                     # SERVER  | OPTIONAL — rotate annually
VAPID_SUBJECT=mailto:support@yourdomain.com  # SERVER  | OPTIONAL

# -----------------------------------------------------------------------------
# Cron Job Security (REQUIRED in production)
#
# All four routes under /api/cron fail closed when NODE_ENV=production and this
# is unset — daily-report, payment-followup and reactivate-delayed return 500
# ("Server misconfiguration"), broadcast returns 401. Scheduled jobs are dead in
# production without it. Unset in development, the first three allow
# unauthenticated calls for local testing; broadcast still rejects them.
#
# Generate: openssl rand -base64 32
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# -----------------------------------------------------------------------------
CRON_SECRET=                           # SERVER  | REQUIRED in production, OPTIONAL in dev — rotate on team change

# -----------------------------------------------------------------------------
# Upstash Redis (OPTIONAL — production rate limiting & caching)
# Get free credentials at https://console.upstash.com
# Without this, rate limiting uses in-memory store (single-instance only)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=                # SERVER  | OPTIONAL — e.g. https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=              # SERVER  | OPTIONAL — rotate quarterly

# -----------------------------------------------------------------------------
# Upstash QStash — Webhook Delivery (OPTIONAL — reliable webhook dispatch)
# -----------------------------------------------------------------------------
QSTASH_TOKEN=                          # SERVER  | OPTIONAL — rotate quarterly
QSTASH_CURRENT_SIGNING_KEY=            # SERVER  | OPTIONAL
QSTASH_NEXT_SIGNING_KEY=               # SERVER  | OPTIONAL

# -----------------------------------------------------------------------------
# OpenAI (OPTIONAL — if absent, AI features disabled, templates used instead)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                        # SERVER  | OPTIONAL — rotate quarterly

# -----------------------------------------------------------------------------
# QPay Payment Gateway (OPTIONAL — required for payments in Mongolia)
# -----------------------------------------------------------------------------
QPAY_BASE_URL=https://merchant.qpay.mn/v2  # SERVER  | OPTIONAL
QPAY_USERNAME=                         # SERVER  | OPTIONAL — rotate quarterly
QPAY_PASSWORD=                         # SERVER  | OPTIONAL — rotate quarterly
QPAY_INVOICE_CODE=                     # SERVER  | OPTIONAL

# -----------------------------------------------------------------------------
# SMS Gateway (OPTIONAL — SMS notifications)
# -----------------------------------------------------------------------------
SMS_API_URL=                           # SERVER  | OPTIONAL
SMS_API_KEY=                           # SERVER  | OPTIONAL — rotate quarterly

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (OPTIONAL — error tracking & performance)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=                # PUBLIC  | OPTIONAL — build-time inlined
SENTRY_DSN=                            # SERVER  | OPTIONAL — same value as above
SENTRY_AUTH_TOKEN=                     # SERVER  | OPTIONAL — for source map uploads
SENTRY_ORG=                            # SERVER  | OPTIONAL
SENTRY_PROJECT=                        # SERVER  | OPTIONAL

# Performance-trace sampling, 0.0–1.0. Both default to 0.1 (10% of requests) and
# are only applied in production. Server and client are sampled separately, so
# set both if you want a single effective rate.
SENTRY_TRACES_SAMPLE_RATE=0.1              # SERVER  | OPTIONAL — sentry.server.config.ts + src/lib/sentry-init.ts
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1  # PUBLIC  | OPTIONAL — build-time inlined; sentry.client.config.ts

# -----------------------------------------------------------------------------
# Stripe Billing (OPTIONAL — card subscriptions; QPay is the primary gateway)
# Without these, /api/stripe/checkout returns 500 and /api/stripe/webhook 500.
# Price IDs are per-plan; a plan whose price ID is unset returns 400 at checkout,
# so you can enable tiers one at a time.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=                     # SERVER  | OPTIONAL — sk_live_... / sk_test_..., rotate quarterly
STRIPE_WEBHOOK_SECRET=                 # SERVER  | OPTIONAL — whsec_..., verifies /api/stripe/webhook signatures
STRIPE_PRICE_BASIC=                    # SERVER  | OPTIONAL — price_... for the basic plan (89,900₮)
STRIPE_PRICE_STARTER=                  # SERVER  | OPTIONAL — price_... for the starter plan (149,900₮)
STRIPE_PRICE_PRO=                      # SERVER  | OPTIONAL — price_... for the pro plan (249,900₮)

# -----------------------------------------------------------------------------
# Slack Alerts (OPTIONAL — ops notifications via incoming webhooks)
# SLACK_WEBHOOK_URL is the catch-all. The two channel-specific URLs override it
# per channel; either one falls back to SLACK_WEBHOOK_URL when unset. With none
# of the three set, Slack delivery is skipped silently.
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=                     # SERVER  | OPTIONAL — https://hooks.slack.com/services/...
SLACK_ERRORS_WEBHOOK_URL=              # SERVER  | OPTIONAL — 'errors' channel override
SLACK_BUSINESS_WEBHOOK_URL=            # SERVER  | OPTIONAL — 'business' channel override

# -----------------------------------------------------------------------------
# Langfuse — LLM Observability (OPTIONAL — traces OpenAI calls)
# Both keys are required together; tracing stays off unless both are set.
# -----------------------------------------------------------------------------
LANGFUSE_SECRET_KEY=                   # SERVER  | OPTIONAL — sk-lf-..., rotate quarterly
LANGFUSE_PUBLIC_KEY=                   # SERVER  | OPTIONAL — pk-lf-...

# -----------------------------------------------------------------------------
# BERT Intent Classifier (OPTIONAL — self-hosted FastAPI server in bert-api/)
# Unset, chat intent classification falls back to the local ML classifier.
# -----------------------------------------------------------------------------
BERT_API_URL=                          # SERVER  | OPTIONAL — e.g. https://bert.your-domain.com

# -----------------------------------------------------------------------------
# Google Maps API (OPTIONAL — real road ETA for deliveries)
# Without this key, ETA uses district center coords + haversine (still works)
# Get key: https://console.cloud.google.com/apis/credentials
# Enable: Distance Matrix API + Geocoding API
# Free tier: $200/month credit (~40,000 requests)
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=                   # SERVER  | OPTIONAL

# -----------------------------------------------------------------------------
# Operational toggles (OPTIONAL — leave unset in normal production)
# -----------------------------------------------------------------------------
SUPERVISOR_MODE=off                    # SERVER  | OPTIONAL — 'off' | 'shadow' | 'on'; SupervisorAgent delegation in chat-ai-handler. Anything else reads as 'off'
SENTRY_TEST_TOKEN=                     # SERVER  | OPTIONAL — guards GET /api/sentry-test?token=... Unset, that route returns 503
DATABASE_URL=                          # SERVER  | OPTIONAL — direct Postgres URL for src/lib/db.ts (PostgREST-bypass helper). Defaults to LOCAL Supabase, so set it if anything starts using that module in production

# -----------------------------------------------------------------------------
# Test-only (never set these in production)
# -----------------------------------------------------------------------------
E2E_RATE_LIMIT_BYPASS=                 # SERVER  | OPTIONAL — 'true' disables rate limiting for Playwright runs
RUN_REAL_AI=                           # SERVER  | OPTIONAL — '1' lets the AI test suites call the real OpenAI API
